{
  "name": "yihuan-piano-zcode",
  "version": "1.1.0",
  "description": "异环乐器模拟器 — 钢琴/吉他双乐器虚拟键盘 + MIDI 演奏",
  "main": "main.js",
  "author": "林羽empty <969761220@qq.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "node tools/serve.mjs",
    "fetch-audio": "node tools/fetch-audio.mjs",
    "make-demo": "node tools/make-demo-midi.mjs",
    "dist:dir": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zcode.yihuanpiano",
    "productName": "YihuanInstrument",
    "copyright": "Copyright © 2026 林羽empty",
    "directories": {
      "output": "dist12"
    },
    "files": [
      "main.js",
      "preload.js",
      "perf-main.js",
      "perf-ffi.js",
      "perf-worker.js",
      "build/icon.ico",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "audio/**/*",
          "demo/**/*",
          "builtin/**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "异环乐器模拟器",
      "artifactName": "YihuanInstrument-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
